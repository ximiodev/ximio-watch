# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version

# Tests and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Environment and secrets
.env
.env.*
!.env.example
secrets/
secret/
*.secret
*.secrets

# Private monitor configuration
config/private/
config/local/
config/production/
config/monitors.local.*
config/monitors.*.local.*
config/monitors.production.*
config/monitors.*.production.*
config/monitors.*.yaml
config/monitors.*.yml
!config/monitors.example.yaml
!config/monitors.*.example.yaml

# Private Alertmanager / Telegram configuration and secrets
alertmanager/private/
alertmanager/secrets/
alertmanager/*.local.yml
alertmanager/*.local.yaml
alertmanager/*telegram*.local.*
alertmanager/*.token
alertmanager/*.chat_id
*.telegram_token
*.chat_id

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_ed25519

# Local AI assistant configuration and transcript artifacts
.claude/
.cursor/
.opencode/
.windsurf/
CLAUDE.local.md
AGENTS.local.md
*.prompt
*.prompt.md
*transcript*
*conversation*
*session*

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Docker / runtime data
grafana/data/
prometheus/data/
*.log

# Verification fixtures, mock receiver and monitor configuration are intentionally
# versioned because the documented Compose overlay mounts them at runtime. Only
# generated artifacts and private configuration are excluded above.
