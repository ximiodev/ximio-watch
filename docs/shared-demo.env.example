# Sanitized environment example for docker-compose.shared-demo.yml.
# Copy to a private, ignored file such as .env.shared-demo on the VPS and
# replace only the two Grafana values with local secrets. Do not commit it.

# Required Grafana credentials. Use a unique password that is not "admin".
SHARED_GRAFANA_ADMIN_USER=admin
SHARED_GRAFANA_PASSWORD_FILE=./secrets/grafana_admin_password

# Optional fictional demo token sent to the local demo API.
SHARED_DEMO_TOKEN=demo-token

# Optional read-only monitor configuration override, relative to the Compose file.
# The default bundled config/monitors.yaml is used when this is omitted.
# SHARED_MONITOR_CONFIG=./config/monitors.yaml

# Optional loopback host ports.
SHARED_XIMIOWATCH_PORT=18100
SHARED_DEMO_API_PORT=18101
SHARED_PROMETHEUS_PORT=19090
SHARED_GRAFANA_PORT=13000
SHARED_ALERTMANAGER_PORT=19093

# Optional runtime limits. Defaults total 1024 MiB and 0.95 vCPU.
SHARED_XIMIOWATCH_MEMORY=192M
SHARED_XIMIOWATCH_MEMORY_RESERVATION=128m
SHARED_XIMIOWATCH_CPUS=0.20
SHARED_XIMIOWATCH_PIDS_LIMIT=128
SHARED_DEMO_API_MEMORY=96M
SHARED_DEMO_API_MEMORY_RESERVATION=64m
SHARED_DEMO_API_CPUS=0.10
SHARED_DEMO_API_PIDS_LIMIT=64
SHARED_PROMETHEUS_MEMORY=320M
SHARED_PROMETHEUS_MEMORY_RESERVATION=192m
SHARED_PROMETHEUS_CPUS=0.25
SHARED_PROMETHEUS_PIDS_LIMIT=256
SHARED_GRAFANA_MEMORY=320M
SHARED_GRAFANA_MEMORY_RESERVATION=192m
SHARED_GRAFANA_CPUS=0.30
SHARED_GRAFANA_PIDS_LIMIT=256
SHARED_ALERTMANAGER_MEMORY=96M
SHARED_ALERTMANAGER_MEMORY_RESERVATION=64m
SHARED_ALERTMANAGER_CPUS=0.10
SHARED_ALERTMANAGER_PIDS_LIMIT=64

# Optional Prometheus retention flags. Size is not a strict filesystem quota.
SHARED_PROMETHEUS_RETENTION_TIME=7d
SHARED_PROMETHEUS_RETENTION_SIZE=512MB
